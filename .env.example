# ─────────────────────────────────────────────────────────────────────────────
# google-analytics-mcp-server configuration
# The three OAuth values are required. See the README for how to get them.
# ─────────────────────────────────────────────────────────────────────────────

# OAuth client, created in a Google Cloud project with the Google Analytics
# Data API and Admin API enabled. Use a Desktop app client for local use.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=

# Refresh token obtained once through the OAuth consent flow, for a Google
# account with access to the GA4 properties you want to read.
# The analytics.readonly scope is enough.
GA4_REFRESH_TOKEN=

# Optional. Saves passing propertyId on every call.
# GA4_PROPERTY_ID=

# debug | info | warn | error
# LOG_LEVEL=info
